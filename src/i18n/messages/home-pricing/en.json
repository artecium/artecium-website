    "faq": {
      "items": {
        "implementationVsMonthly": {
          "question": "What is the difference between implementation and the monthly fee?",
          "answer": "Implementation (or initial setup) covers building, configuring and launching the service. The monthly fee covers support, maintenance, monitoring or service continuity, depending on the plan. Exact amounts are confirmed in your proposal."
        },
        "vat": {
          "question": "Do prices include VAT?",
          "answer": "Unless stated otherwise in the proposal, prices shown are indicative and VAT will be applied according to applicable law and the client's tax status."
        },
        "singleService": {
          "question": "Can I hire just one service?",
          "answer": "Yes. You can hire Websites, AI & Automation, SEO or Booking independently, based on your business needs."
        },
        "changePlan": {
          "question": "Can I change plans later?",
          "answer": "Yes, when it makes sense for the project. Plan changes are handled through an updated proposal and agreed contractual terms."
        },
        "hosting": {
          "question": "Is hosting included?",
          "answer": "For the Website plans listed, hosting is included in the support monthly fee unless stated differently in the proposal."
        },
        "externalCosts": {
          "question": "Are API and external tool costs included?",
          "answer": "Not automatically. API, AI model, third-party platform and usage costs are charged according to actual use or as agreed in the proposal, especially for AI & Automation."
        },
        "cancelMonthly": {
          "question": "Can I cancel a monthly fee?",
          "answer": "Yes, under the termination terms set in the contract or accepted proposal. One-off services such as SEO Foundation do not require a monthly fee."
        },
        "customFeatures": {
          "question": "Can I request custom features?",
          "answer": "Yes. Additional features, complex integrations or bespoke development are quoted separately based on scope."
        },
        "bookingExistingSite": {
          "question": "Can Booking work with a website I already have?",
          "answer": "Yes. Booking is a standalone product and can be linked to your current website via links, embed or integration agreed during implementation."
        },
        "timeline": {
          "question": "How long does implementation take?",
          "answer": "It depends on the plan and scope. After reviewing your request, we provide a realistic timeline in the proposal — from a few weeks (essential plans) to longer for Business solutions."
        }
      }
    }
