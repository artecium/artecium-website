    "faq": {
      "items": {
        "implementationVsMonthly": {
          "question": "Qual é a diferença entre implementação e mensalidade?",
          "answer": "A implementação (ou configuração inicial) cobre o trabalho de criação, configuração e arranque do serviço. A mensalidade cobre acompanhamento, manutenção, monitorização ou continuidade do serviço, conforme o plano. Os valores exatos são confirmados na proposta."
        },
        "vat": {
          "question": "Os preços incluem IVA?",
          "answer": "Salvo indicação em contrário na proposta, os valores apresentados são indicativos e o IVA será aplicado conforme a legislação em vigor e o enquadramento fiscal do cliente."
        },
        "singleService": {
          "question": "Posso contratar apenas um serviço?",
          "answer": "Sim. Pode contratar Websites, IA & Automação, SEO ou Booking de forma independente, consoante as necessidades do negócio."
        },
        "changePlan": {
          "question": "Posso mudar de plano mais tarde?",
          "answer": "Sim, quando faz sentido para o projeto. A alteração de plano é tratada mediante proposta atualizada e condições contratuais acordadas."
        },
        "hosting": {
          "question": "O alojamento está incluído?",
          "answer": "Nos planos de Websites indicados, o alojamento está incluído na mensalidade de acompanhamento, salvo indicação diferente na proposta."
        },
        "externalCosts": {
          "question": "Os custos de APIs e ferramentas externas estão incluídos?",
          "answer": "Não automaticamente. Custos de APIs, modelos de IA, plataformas de terceiros e consumo associado são faturados conforme utilização real ou acordado na proposta, especialmente em IA & Automação."
        },
        "cancelMonthly": {
          "question": "Posso cancelar uma mensalidade?",
          "answer": "Sim, mediante as condições de rescisão definidas no contrato ou proposta aceite. Os serviços pontuais, como SEO Foundation, não implicam mensalidade obrigatória."
        },
        "customFeatures": {
          "question": "Posso pedir funcionalidades personalizadas?",
          "answer": "Sim. Funcionalidades adicionais, integrações complexas ou desenvolvimento à medida são orçamentados à parte, conforme o alcance do pedido."
        },
        "bookingExistingSite": {
          "question": "O Booking pode funcionar com um website que já tenho?",
          "answer": "Sim. O Booking é um produto independente e pode ser ligado ao seu website atual através de links, incorporação ou integração acordada na implementação."
        },
        "timeline": {
          "question": "Quanto tempo demora a implementação?",
          "answer": "Depende do plano e do âmbito. Após análise do pedido, indicamos um calendário realista na proposta — tipicamente desde algumas semanas (planos essenciais) até projectos mais longos para soluções Business."
        }
      }
    }
