# Artecium Lab — PROTOTYPE (copy to .env.prototype.local, never commit)
# Use: npm run dev:prototype

ARTECIUM_RUNTIME=prototype
ARTECIUM_LAB=1
NEXT_PUBLIC_ARTECIUM_RUNTIME=prototype
NEXT_PUBLIC_ARTECIUM_LAB=1

# No hosted Supabase — leave empty (mock-only prototypes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No payments
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# No outbound email
EMAIL_PROVIDER=noop

# Optional AI for experiments (never required for Lume Studio)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=