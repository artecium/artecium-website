# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.booking.test.local.example
!.env.booking.sandbox.local.example
!.env.booking.prod.local.example
!.env.client-isolation.local.example
# Booking integration credentials (copy from example; never commit)
.env.booking.test.local
.env.booking.sandbox.local
.booking-seed.lock

# local agent / harness artifacts
.cursor-audit-*
audit-summary-utf8.json
.harness-pg-*/

# supabase cli temp (do not commit)
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
