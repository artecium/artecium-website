# Booking integration — test Supabase only (copy to .env.booking.test.local)
# Never commit .env.booking.test.local. Do not use production project refs.

# Required to run seed / integration / readiness against hosted test project
BOOKING_ALLOW_REMOTE_TESTS=1

# Optional extra guard: must match NEXT_PUBLIC_SUPABASE_URL project ref
BOOKING_EXPECTED_PROJECT_REF=bwxhdoxesqtdqwkxrmom

NEXT_PUBLIC_SUPABASE_URL=https://bwxhdoxesqtdqwkxrmom.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/scripts only — never expose in the browser or commit
SUPABASE_SERVICE_ROLE_KEY=

# Min 12 characters — used for booking-*@artecium.test auth users in integration seed
BOOKING_TEST_PASSWORD=

# Optional: read-only pg_catalog / schema_migrations (SELECT only, same as demo seed)
# SUPABASE_DB_PASSWORD=

# Flags (set to 1 when running the matching command)
# BOOKING_PLATFORM_READINESS=1
# BOOKING_DB_READINESS=1
# BOOKING_SEED=1
# BOOKING_INTEGRATION_TEST=1
# BOOKING_RLS_TEST=1
# BOOKING_M022_PREFLIGHT=1
# Run: npx -p pg node --env-file=.env.booking.test.local scripts/booking-migration-022-preflight-readonly.mjs
# BOOKING_PHASE2_P2_REMOTE=1
# Read-only P2: npx -p pg node --env-file=.env.booking.test.local scripts/booking-phase2-p2-remote-readonly.mjs
