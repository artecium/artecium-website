# Booking integration — Supabase sandbox only (copy to .env.booking.sandbox.local)
# Never commit .env.booking.sandbox.local.
# PROHIBITED for this phase: .env.booking.test.local (legacy ref bwxhdoxesqtdqwkxrmom).

# Confirms intentional use of this file (required for remote write scripts)
BOOKING_SANDBOX_ENV_LOADED=1

# Required to run seed / integration / readiness against hosted sandbox
BOOKING_ALLOW_REMOTE_TESTS=1

# Must match NEXT_PUBLIC_SUPABASE_URL project ref (sandbox ahbtpmlrzruwtfcichlg)
BOOKING_EXPECTED_PROJECT_REF=ahbtpmlrzruwtfcichlg

NEXT_PUBLIC_SUPABASE_URL=https://ahbtpmlrzruwtfcichlg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/scripts only — never expose in the browser or commit
SUPABASE_SERVICE_ROLE_KEY=

# Min 12 characters — used for booking-*@artecium.test auth users in integration seed
BOOKING_TEST_PASSWORD=

# Optional: read-only pg_catalog / schema_migrations (SELECT only)
# SUPABASE_DB_PASSWORD=

# Flags (set to 1 when running the matching command)
# BOOKING_PLATFORM_READINESS=1
# BOOKING_DB_READINESS=1
# BOOKING_SEED=1
# BOOKING_INTEGRATION_TEST=1
# BOOKING_RLS_TEST=1