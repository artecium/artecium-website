# Production Supabase — local file only (copy to .env.booking.prod.local).
# Never commit .env.booking.prod.local. Never use the integration-test project ref here.

BOOKING_PROD_READONLY=1
# Must match hostname in NEXT_PUBLIC_SUPABASE_URL (production ref only)
BOOKING_PROD_PROJECT_REF=your-production-project-ref
# Optional double-check (must equal BOOKING_PROD_PROJECT_REF if set)
BOOKING_EXPECTED_PROJECT_REF=your-production-project-ref

NEXT_PUBLIC_SUPABASE_URL=https://your-production-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/scripts only — never expose in browser or commit
SUPABASE_SERVICE_ROLE_KEY=

# Read-only catalog probes (Dashboard → Database → connection string, postgres user)
# SUPABASE_DB_PASSWORD=
# Or full URL:
# DATABASE_URL=postgresql://postgres:***@db.your-production-project-ref.supabase.co:5432/postgres